---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Contact information for Dhrex’s SaaS motion-design portfolio.">
  <section class="page-intro container contact-intro"><p class="small-label">Contact</p><h1 class="display">Let’s make<br/><span class="display-accent">something move.</span></h1><p class="intro-copy">A place to begin a conversation about your next motion-design project.</p></section>
  <section class="container contact-details" aria-label="Contact details"><h2>Say hello.</h2><div>{site.email ? <a class="email-link" href={`mailto:${site.email}`}>{site.email}<Arrow/></a> : <><p class="contact-pending">Contact details coming soon.</p><p class="content-note">A verified email address has not been supplied yet. This page is not accepting messages.</p></>}{site.socials.length > 0 && <ul class="social-links">{site.socials.map(social => <li><a class="text-link" href={social.url}>{social.label}<Arrow/></a></li>)}</ul>}<a class="text-link" href="/work">Explore the work <Arrow/></a></div></section>
</Base>
