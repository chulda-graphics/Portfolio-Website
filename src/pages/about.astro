---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import MediaFrame from '../components/MediaFrame.astro';
---
<Base title="About" description="Meet Dhrex, a SaaS motion designer.">
  <section class="page-intro container"><p class="small-label">About</p><h1 class="display">Dhrex.<br/><span class="display-accent">Behind the motion.</span></h1></section>
  <section class="container about-layout"><MediaFrame label="A face to the name." detail="Portrait not supplied" class="portrait-frame"/><div class="about-copy"><h2>SaaS motion<br/>designer.</h2><p>This portfolio brings together my motion-design work for digital products.</p><p class="content-note">A personal biography, background and process description have not been supplied yet.</p><a class="button button-primary" href="/contact">Let’s talk <Arrow/></a></div></section>
  <section class="section container"><div class="section-heading"><h2>Explore the work.</h2><a class="text-link" href="/work">View Work <Arrow/></a></div></section>
</Base>
