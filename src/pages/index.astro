---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import MediaFrame from '../components/MediaFrame.astro';
import WorkList from '../components/WorkList.astro';
---
<Base>
  <section class="home-hero container">
    <p class="identity"><span class="identity-line" aria-hidden="true"></span>Dhrex — SaaS motion designer</p>
    <h1 class="display">SaaS stories.<br/><span class="display-accent">Designed to move.</span></h1>
    <div class="hero-bottom"><p>A personal portfolio of motion design<br class="desktop-break"/> for digital products.</p><div class="button-row"><a class="button button-primary" href="/work">View Work <Arrow/></a><a class="button button-glass glass" href="/contact">Contact <Arrow/></a></div></div>
    <MediaFrame label="The reel is next." detail="Reel and poster not supplied" class="reel-frame"/>
  </section>
  <section class="section container" aria-labelledby="work-heading"><div class="section-heading"><h2 id="work-heading">Selected work<span class="green-dot" aria-hidden="true">.</span></h2><a class="text-link" href="/work">All work <Arrow/></a></div><WorkList/></section>
  <section class="section container about-teaser"><p class="small-label">Behind the motion</p><div><h2>Thoughtful design.<br/>A sense of movement.</h2><p>I’m Dhrex, a SaaS motion designer. This is where my work and the stories behind it will live.</p><a class="text-link" href="/about">Meet Dhrex <Arrow/></a></div></section>
  <section class="contact-close container"><p class="small-label">Start a conversation</p><a href="/contact" class="contact-heading">Let’s make<br/><span>something move.</span><Arrow/></a></section>
</Base>
